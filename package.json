{
  "name": "onda",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.1",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:web": "bun --filter @onda/web dev",
    "dev:api": "bun --filter @onda/api dev",
    "build": "bun --filter @onda/web build",
    "test": "bun test",
    "typecheck": "bun --filter @onda/web typecheck && bun --filter @onda/api typecheck"
  }
}
